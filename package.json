{
  "name": "rideo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rideo/database db:generate",
    "db:migrate": "pnpm --filter @rideo/database db:migrate",
    "db:studio": "pnpm --filter @rideo/database db:studio",
    "db:seed": "pnpm --filter @rideo/database db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
